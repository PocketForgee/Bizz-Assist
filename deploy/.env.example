# Copy to deploy/.env on the server. Never commit the real file.

# Public hostname Caddy gets a certificate for. Its A record (and www) must point at the server.
# Without a domain, <ip-with-dashes>.sslip.io works with no DNS setup.
DOMAIN=bizzassist.biz

# Postgres password. Letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Nexconn console > App Key / App Secret. Area: SG, NA or SA (must match the app's data center).
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_AREA=SG

# Google AI Studio: API key and two model ids. Main answers customers (needs tool calling);
# lite handles translation, chat summaries and learned suggestions.
# LLM_API_KEY takes several keys, comma separated (key1,key2,key3). When one hits its rate limit or quota
# the next is used; if every key fails, the chat goes to a person.
LLM_API_KEY=
LLM_MODEL_MAIN=
LLM_MODEL_LITE=

# Required for API Actions: encrypts their headers at rest. 64 hex chars: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Local dev only (web/.env.local); in Docker compose sets these itself:
# DATABASE_URL=postgres://bizzassist:PASSWORD@localhost:5432/bizzassist
# APP_URL=http://localhost:3000
