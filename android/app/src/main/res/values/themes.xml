<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window theme only sets the launch background and light system bars. -->
    <style name="Theme.BizzAssist" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pearl</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
</resources>
